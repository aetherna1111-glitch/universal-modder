# Copy to /etc/luminary-auth.env (chmod 600, owner root) and edit. No secrets are needed here:
# the RSA signing key is generated on first start inside LUMINARY_DATA_DIR.

# Public HTTPS address of this service (no trailing slash). Players' launchers and the Minecraft
# server talk to it; Minecraft clients download skins from <this>/textures/...
LUMINARY_PUBLIC_URL=https://auth.example.org

# Database (SQLite), signing key and uploaded textures live here. Back it up (see backup.sh).
LUMINARY_DATA_DIR=/var/lib/luminary-auth

LUMINARY_SERVER_NAME=Luminary

# Set to 0 to stop new registrations (existing accounts keep working).
LUMINARY_REGISTRATION_OPEN=1

# 1 = trust X-Forwarded-For from the local reverse proxy (Caddy below). Keep 0 if exposed directly.
LUMINARY_TRUST_PROXY=1

# Optional: launcher sessions (seconds, default 30 days) and game tokens (default 48 h).
#LUMINARY_SESSION_TTL=2592000
#LUMINARY_GAME_TOKEN_TTL=172800
